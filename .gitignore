# Python bytecode
__pycache__/
*.py[cod]

# Packaging / build artifacts
*.egg-info/
build/
dist/

# Virtualenvs — the user brings their own
.venv/
venv/

# Credential profiles. A per-user profile is personal and must never be
# committed; its `*.example` beside it is the committable template. Two are
# deliberate exceptions — a shared key shipped so a fresh clone can start:
# Logfare's (a template with a placeholder, because its key is budgeted) and
# Token Juice's (a real shared key, because the route is meant to work with no
# signup at all). Flex's is a third kind of exception: it carries no credential
# at all — the playground authenticates nothing — so it is a route record, and
# /zim-flex is documented as working on a fresh clone because of it.
packaging/*/source
!packaging/logfare/source
!packaging/tokenjuice/source
!packaging/flex/source

