# scope.yaml — network allow-list for bug-bounty engagements.
#
# Copy to `scope.yaml` next to where you run the harness (or point at it with
# --scope). When a scope file is loaded, every bash command that reaches a host
# outside this list is HARD-BLOCKED before it runs.
#
# An empty scope file (no domains/ips/cidrs) means "nothing is authorised" and
# blocks all network targets — it never means "everything". To disable the
# guard entirely, remove the file.

# Domains and subdomains. A listed domain also authorises its subdomains.
domains:
  - example.com
  - app.example.com
  - api.example.org

# Individual IP addresses.
ips:
  - 203.0.113.10

# CIDR ranges.
cidrs:
  - 198.51.100.0/24

# `in_scope` and `hosts` are accepted as aliases for `domains` and `ips`.
# in_scope:
#   - staging.example.com
