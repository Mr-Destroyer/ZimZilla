# ZimZilla — Logfare profile
#
# This file is the credential profile for the local LiteLLM proxy. setup.sh
# writes the real one next to this example as `source`, with mode 600, and
# never commits it.
#
# Get a key from https://logfare.ai (API keys start with `lfu_`).

export ANTHROPIC_BASE_URL="http://localhost:4001"
export ANTHROPIC_AUTH_TOKEN="lfu_REPLACE_ME"
export ANTHROPIC_MODEL="deepseek-v4.1-flash"

# Load-bearing: ZimZilla (like Claude Code) prefers ANTHROPIC_AUTH_TOKEN
# (Bearer) and only falls back to ANTHROPIC_API_KEY (x-api-key) if the token is
# falsy. An empty string keeps the token authoritative and clears any real API
# key inherited from the shell.
export ANTHROPIC_API_KEY=""

# Model aliases — switch per-invocation, e.g.:
#   ANTHROPIC_MODEL=$MODEL_KIMI zimzilla
# Full list lives in litellm-config.yaml next to this file.
export MODEL_DEFAULT="deepseek-v4.1-flash"
export MODEL_OPUS="claude-opus-4.6"
export MODEL_SONNET="claude-sonnet-4.6"
export MODEL_DEEPSEEK="deepseek-v3.2"
export MODEL_DEEPSEEK_FLASH="deepseek-v4.1-flash"
export MODEL_KIMI="kimi-k2.5"
export MODEL_KIMI_THINKING="kimi-k2-thinking"
export MODEL_GLM="glm-5"
export MODEL_GROK="grok-4.6"
export MODEL_QWEN="qwen-3.8-27b"
export MODEL_GEMMA="gemma-4-26b"
export MODEL_GEMMA_31B="gemma-4-31b"
export MODEL_GPT_OSS="gpt-oss-120b"
export MODEL_AUTO="logfare/auto"
