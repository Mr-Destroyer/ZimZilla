# ZimZilla — Token Juice profile
#
# This file is the credential profile for the Token Juice route. Copy it to
# `source` beside this example and put your key in — setup.sh does that for you
# when $ANTHROPIC_AUTH_TOKEN already holds a tj_ key, and writes it mode 600.
#
# `source` is gitignored; only this template is committed. A `source` file was
# committed here once, carrying a live key, which is why the route now reports
# itself unavailable rather than shipping a working profile.
#
# There is no proxy on this route. Token Juice serves Chat Completions itself,
# so ZimZilla talks to it directly: the URL below is the upstream, not a
# localhost port, and nothing needs starting. The key is the only thing this
# file has to carry — it is the bearer token for every request.
#
# Token Juice keys start with `tj_`.

export ANTHROPIC_BASE_URL="https://api.tokenjuice.ai/v1"
export ANTHROPIC_AUTH_TOKEN="tj_REPLACE_ME"
# The id the upstream itself serves. The snapshot suffix rotates; /zim-tokenjuice
# re-reads the live catalog on every switch and moves to the current one.
export ANTHROPIC_MODEL="deepseek-ai/DeepSeek-V4.1-Flash-1017"

# Load-bearing: an empty string keeps ANTHROPIC_AUTH_TOKEN authoritative and
# clears any real API key inherited from the shell.
export ANTHROPIC_API_KEY=""

# Token Juice serves exactly one chat model, so there is nothing to alias.
export MODEL_DEFAULT="deepseek-ai/DeepSeek-V4.1-Flash-1017"
